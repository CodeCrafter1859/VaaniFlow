APP_NAME="Speech to Text API"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/speech_to_text
DATABASE_SSL=false
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=auto
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_DURATION=3
AUDIO_OVERLAP_DURATION=1
MAX_SESSION_DURATION=300
MAX_AUDIO_SIZE_MB=10
MAX_WORKER_SESSIONS=4
TRANSCRIPTION_SERVICE_URL=http://localhost:8001
TRANSCRIPTION_WEBSOCKET_URL=ws://localhost:8001/ws/transcribe
TRANSCRIPTION_SERVICE_API_KEY=replace_with_secure_key
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
